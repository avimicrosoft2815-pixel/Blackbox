{
  "name": "blackbox-film",
  "private": true,
  "version": "0.1.0",
  "description": "The BlackBox demo film and Director Studio. Isolated from the recorder: nothing here is imported by src/blackbox.",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "studio": "node serve.mjs",
    "film": "node tools/render_film.mjs",
    "film:4k": "node tools/render_film.mjs --height 2160 --label 4k --crf 20",
    "still": "node tools/render_frames.mjs",
    "test": "node --test tools/test_film.mjs tools/test_studio.mjs",
    "check": "node tools/render_frames.mjs --scene 1 --pct 40 --out /tmp/blackbox-check"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "jsdom": "^31.0.1"
  }
}